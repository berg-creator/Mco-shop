# Токен бота. Берётся у @BotFather: /newbot, потом /mybots → API Token.
TELEGRAM_BOT_TOKEN=

# Telegram id владельца магазина — ему падают заявки и он же имеет доступ
# к админке. Узнать свой id: написать @userinfobot.
# Через запятую можно перечислить несколько (владелец + помощник).
ADMIN_IDS=

# Адрес витрины, который бот подставляет в кнопку «Открыть магазин».
# Telegram принимает только HTTPS, поэтому локально — адрес туннеля
# (cloudflared tunnel --url http://127.0.0.1:8080), на сервере — свой домен.
# Обязательно с завершающим /app/
WEBAPP_URL=

# Название магазина в текстах бота и заголовке витрины.
SHOP_NAME=Mco shop

# На каком порту слушает HTTP-сервер витрины.
PORT=8080

# Способы доставки через точку с запятой — как их называет магазин.
DELIVERY_OPTIONS=Самовывоз;СДЭК;Почта России;Доставка по городу

# Валюта в подписях цен.
CURRENCY=₽
